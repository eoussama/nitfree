{
  "name": "nitfree",
  "displayName": "Nitfree",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "The definitive freemium Discord Nitro alternative",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "lint": "dx lint",
    "lint:fix": "dx fix",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@eoussama/core": "^0.1.0"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.1.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
