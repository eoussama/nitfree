{
  "name": "nitfree",
  "displayName": "Nitfree",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "The definitive freemium Discord Nitro alternative",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "lint": "dx lint",
    "lint:fix": "dx fix",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "wxt prepare",
    "check": "pnpm audit && pnpm lint && pnpm typecheck && pnpm build:all && pnpm test:coverage && pnpm test:e2e"
  },
  "dependencies": {
    "@eoussama/core": "^0.1.2",
    "@fontsource/noto-sans": "^5.3.0",
    "@lucide/svelte": "^1.50.0",
    "@wxt-dev/i18n": "^0.2.8",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.1.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
